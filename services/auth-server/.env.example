# Same as production API — users live in Supabase/Postgres
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require
SECRET_KEY=replace-with-long-random-secret-must-match-api-service
AUTH_PEPPER=replace-with-same-pepper-as-api-if-set
TOKEN_EXPIRE_HOURS=24

# Render private service: bind all interfaces on Render's PORT
AUTH_SOCKET_HOST=0.0.0.0
# AUTH_SOCKET_PORT is set automatically from $PORT on Render
