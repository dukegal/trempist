# Same values as Render dashboard → Environment (required for local JWT → production API)
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require
SECRET_KEY=replace-with-long-random-secret-must-match-render
AUTH_PEPPER=replace-with-same-pepper-as-render-if-set
TOKEN_EXPIRE_HOURS=24
CORS_ORIGINS=https://your-frontend.onrender.com

# Local TCP auth server (default: 127.0.0.1:9000)
AUTH_SOCKET_HOST=127.0.0.1
AUTH_SOCKET_PORT=9000
